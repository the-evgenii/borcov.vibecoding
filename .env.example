# Copy to .env and edit before running.
# Never commit the real .env file.
APP_ENV=prod
APP_DEBUG=0
APP_TIMEZONE=UTC

# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_COOKIE_VALIDATION_KEY=replace-with-a-random-64-character-key
# Set to 1 only when the app is served over HTTPS.
APP_COOKIE_SECURE=0

# SQLite is the default. The @app alias is expanded by the application.
APP_DB_DSN=sqlite:@app/runtime/db.sqlite

# Used by: php yii app/init-admin
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-strong-password
